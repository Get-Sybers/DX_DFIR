// Byakugan risk gate — proof 1, check 1.4: a detection run ON DEMAND over an
// explicit EVIDENCE-TIME window. The fixture is dead-box evidence dated
// 2019-04-12; a scheduled Detection Engine rule (lookback relative to NOW())
// can never see it — the runner executes the rule through POST /_query with
// the window written into the WHERE clause instead.
//
// Shape: a Byakugan line-shaped ES|QL rule (python/get_sybers_dxdfir/detect/rules/
// README.md) — METADATA _id/_index/_version so the Detection Engine would raise
// one alert per matched document, the rule identity + ATT&CK mapping EVAL'd
// inline (the tagged evidence line). The riskgate-* rule ids are local to this
// harness; they are not part of the rule set.
//
// The trailing KEEP/SORT is proof-only: it fixes the table expected/ pins.
// Production rules keep every source field (no KEEP).
//
// EVIDENCE WINDOW: 2019-04-12 (UTC), the fixture's day. Edit both bounds
// together if you point the harness at other evidence.
FROM logs-car.process-riskgate METADATA _id, _index, _version
| WHERE @timestamp >= TO_DATETIME("2019-04-12T00:00:00.000Z")
    AND @timestamp <  TO_DATETIME("2019-04-13T00:00:00.000Z")
    AND event.action == "create"
    AND TO_LOWER(process.name) == "wevtutil.exe"
    AND TO_LOWER(process.command_line) LIKE "* cl *"
| EVAL rule.id = "riskgate-wevtutil-clear",
       rule.name = "wevtutil clearing an event log",
       event.risk_score = 73.0,
       threat.framework = "MITRE ATT&CK",
       threat.tactic.id = "TA0005",
       threat.tactic.name = "Defense Evasion",
       threat.technique.id = "T1070.001",
       threat.technique.name = "Indicator Removal: Clear Windows Event Logs"
| KEEP @timestamp, event.id, host.name, process.name, process.command_line,
       rule.id, rule.name, event.risk_score, threat.tactic.id, threat.technique.id
| SORT @timestamp ASC
| LIMIT 100
