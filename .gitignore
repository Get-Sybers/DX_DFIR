### AL ###
#Template for AL projects for Dynamics 365 Business Central
#launch.json folder
.vscode/
.code-workspace
.claude
CLAUDE.md

# Zone Identifier
# Windows
**Thumbs.db
**ehthumbs.db
**Desktop.ini
**$RECYCLE.BIN/

# macOS
**.DS_Store
**.AppleDouble

# Cred files
*.pem
*.key
*.crt
*.License

# Junk
**.ZoneIdentifier
**:ZoneIdentifier
**_ZoneIdentifier
**.DS_Store
**.spl
**.tar.gz
**.zip
# Python bytecode
__pycache__/
*.py[cod]

# Tool caches (pytest writes a self-ignoring .gitignore into .pytest_cache, but
# don't depend on that courtesy file)
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/

# Packaging / build output
build/
dist/
*.egg-info/

# Ansible / editor droppings
*.retry
*.swp
*~

# Build / runtime artefacts
err.log
# ansible log_path target: keep the dir, ignore its contents
logs/*
!logs/.gitkeep
# Where ansible imports land in-tree: ansible-lint's project-local collection
# cache, and checks CI's requirements install target
# (ansible/collections/get_sybers.dxdfir/.ansible/collections) — never source.
.ansible/
# The stack's per-host secret store (generated credentials, TLS material,
# the elastic.env handoff) — never committed; keep the dir via its README.
ansible/inventory/secrets/*
!ansible/inventory/secrets/README.md
