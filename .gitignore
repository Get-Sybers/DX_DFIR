### AL ###
#Template for AL projects for Dynamics 365 Business Central
#launch.json folder
.vscode/
.code-workspace
.claude
CLAUDE.md

# Zone Identifier
# Windows
**Thumbs.db
**ehthumbs.db
**Desktop.ini
**$RECYCLE.BIN/

# macOS
**.DS_Store
**.AppleDouble

# Cred files
*.pem
*.key
*.crt
*.License

# Junk
**.ZoneIdentifier
**:ZoneIdentifier
**_ZoneIdentifier
**.DS_Store
**.spl
**.tar.gz
**.zip
# Python bytecode
__pycache__/
*.py[cod]

# Tool caches (pytest writes a self-ignoring .gitignore into .pytest_cache, but
# don't depend on that courtesy file)
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/

# Packaging / build output
build/
dist/
*.egg-info/

# Ansible / editor droppings
*.retry
*.swp
*~

# Build / runtime artefacts
# Generated by the dxdfir_images preflight: a synced mirror of the canonical
# hardening playbook (third_party/EZTools-Docker/hardening/harden.yml) placed in
# the docker/ build context so DX_DFIR's own images (yara/suricata/zeek/plaso)
# can COPY it. Never hand-edit — change it in the EZTools-Docker submodule.
docker/hardening/harden.yml
err.log
# ansible log_path target: keep the dir, ignore its contents
logs/*
!logs/.gitkeep
# ansible-lint's project-local collection cache
.ansible/
