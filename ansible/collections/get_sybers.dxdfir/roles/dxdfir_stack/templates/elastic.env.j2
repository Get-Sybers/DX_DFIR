# ============================================================================
# GENERATED by `dxdfir deploy stack` (dxdfir_stack role) — do not edit.
# The credential handoff for tools outside ansible (the dxdfir TUI's Kibana
# tab, the elastic riskgate). Values come from the
# inventory: override a dxdfir_elastic_* variable (host_vars; ansible-vault
# encrypt_string works) or edit the per-secret files beside this file, then
# redeploy — deploy rewrites this handoff each run. Gitignored; never commit.
# ============================================================================
ELASTICSEARCH_USERNAME=elastic
ELASTIC_PASSWORD={{ dxdfir_stack_elastic_password }}
KIBANA_SYSTEM_PASSWORD={{ dxdfir_stack_kibana_system_password }}
BYAKUGAN_LOADER_PASSWORD={{ dxdfir_stack_byakugan_loader_password }}
ELASTIC_VERSION={{ dxdfir_stack_elastic_version }}
