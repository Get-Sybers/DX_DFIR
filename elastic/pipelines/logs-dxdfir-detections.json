{
  "description": "The signatures lane (detections/<engine>/...): event.module is the engine (yara, suricata, hayabusa, or byakugan's reserved tree), event.dataset <engine>.alert — for Suricata <engine>.<event_type>, so suricata.alert is the alerts and suricata.flow, suricata.dns, ... the rest of its EVE output; evidence time from the engine's own timestamp field (suricata: timestamp, hayabusa: Timestamp).",
  "_meta": {
    "managed_by": "dxdfir_stack",
    "source": "elastic/pipelines/logs-dxdfir-detections.json"
  },
  "processors": [
    {
      "set": {
        "field": "event.kind",
        "value": "alert",
        "override": false
      }
    },
    {
      "grok": {
        "field": "log.file.path",
        "patterns": [
          "^/ingest/detections/(?<_tmp_engine>[^/]+)/"
        ],
        "ignore_missing": true,
        "ignore_failure": true
      }
    },
    {
      "set": {
        "field": "event.module",
        "copy_from": "_tmp_engine",
        "if": "ctx._tmp_engine != null",
        "override": false
      }
    },
    {
      "set": {
        "field": "event.dataset",
        "value": "{{{_tmp_engine}}}.alert",
        "if": "ctx._tmp_engine != null",
        "override": false
      }
    },
    {
      "set": {
        "description": "Suricata writes every EVE record type into eve.json; its event_type names the record",
        "field": "event.dataset",
        "value": "suricata.{{{event_type}}}",
        "if": "ctx._tmp_engine == 'suricata' && ctx.event_type instanceof String",
        "override": true
      }
    },
    {
      "remove": {
        "field": "_tmp_engine",
        "ignore_missing": true
      }
    },
    {
      "date": {
        "field": "timestamp",
        "target_field": "@timestamp",
        "formats": [
          "ISO8601"
        ],
        "if": "ctx.timestamp instanceof String"
      }
    },
    {
      "date": {
        "field": "Timestamp",
        "target_field": "@timestamp",
        "formats": [
          "ISO8601"
        ],
        "if": "ctx.timestamp == null && ctx.Timestamp instanceof String"
      }
    }
  ]
}
