{
  "description": "The log2timeline (Plaso) lane parent (log2timeline/<case>/<image>/timeline.jsonl). Does the Plaso-common work every data_type shares — event.module, labels.case/labels.item from the path, event.dataset from the output filename, evidence time from the epoch-microsecond timestamp (kept as ingest time when absent or the pre-1970 sentinel), filesystem/path grokked out of display_name, host.name from Plaso's hostname (else the image) and user.name from username — then dispatches EVTX records (data_type windows:evtx:record) to the winevtx submodule, which normalises them onto the shared winlog model. The pathspec, date_time and winreg values trees are mapped flattened by logs-dxdfir@log2timeline.",
  "_meta": {
    "managed_by": "dxdfir_stack",
    "source": "elastic/pipelines/logs-dxdfir-log2timeline.json"
  },
  "processors": [
    {
      "set": {
        "field": "event.module",
        "value": "plaso",
        "override": false
      }
    },
    {
      "grok": {
        "description": "log2timeline/<case>/<image>/timeline.jsonl: the case and the image",
        "field": "log.file.path",
        "patterns": [
          "^/ingest/log2timeline/(?<labels.case>[^/]+)/(?<labels.item>[^/]+)/"
        ],
        "ignore_missing": true,
        "ignore_failure": true
      }
    },
    {
      "grok": {
        "field": "log.file.path",
        "patterns": [
          "/(?<_tmp_dataset>[^/]+)\\.jsonl?$"
        ],
        "ignore_missing": true,
        "ignore_failure": true
      }
    },
    {
      "set": {
        "field": "event.dataset",
        "value": "plaso.{{{_tmp_dataset}}}",
        "if": "ctx._tmp_dataset != null",
        "override": false
      }
    },
    {
      "remove": {
        "field": "_tmp_dataset",
        "ignore_missing": true
      }
    },
    {
      "script": {
        "description": "timestamp is epoch MICROseconds; <= 0 is the pre-1970 sentinel (e.g. the Windows FILETIME epoch) — evidence time only when it is a real one",
        "if": "ctx.timestamp instanceof Number && ((Number) ctx.timestamp).longValue() > 0L",
        "source": "ctx['@timestamp'] = Instant.ofEpochMilli(((Number) ctx.timestamp).longValue() / 1000L).toString();"
      }
    },
    {
      "grok": {
        "field": "display_name",
        "patterns": [
          "^%{DATA:plaso.fs_type}:%{GREEDYDATA:file.path}$"
        ],
        "if": "ctx.display_name != null && ctx.file?.path == null",
        "ignore_failure": true
      }
    },
    {
      "set": {
        "field": "host.name",
        "copy_from": "hostname",
        "if": "ctx.hostname instanceof String && ctx.hostname.length() > 0",
        "override": true
      }
    },
    {
      "set": {
        "description": "no hostname on the event: the image stands in",
        "field": "host.name",
        "copy_from": "labels.item",
        "if": "ctx.host?.name == null && ctx.labels?.item instanceof String",
        "override": false
      }
    },
    {
      "set": {
        "field": "user.name",
        "copy_from": "username",
        "if": "ctx.username instanceof String && ctx.username.length() > 0",
        "override": false
      }
    },
    {
      "pipeline": {
        "name": "logs-dxdfir-log2timeline-winevtx",
        "if": "ctx.data_type == 'windows:evtx:record'"
      }
    }
  ],
  "on_failure": [
    {
      "set": {
        "field": "labels.pipeline_error",
        "value": "{{{ _ingest.on_failure_message }}}"
      }
    }
  ]
}
