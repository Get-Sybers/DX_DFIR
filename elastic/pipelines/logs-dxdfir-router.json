{
  "description": "logs-dxdfir.* default pipeline: stamp the ingest time, drop the shipper's host.name (Filebeat stamps its own container as host.name on every record; the evidence host is set by the per-type pipeline, agent.* still identifies the shipper), then hand the record to its evidence type's pipeline. labels.type is the first path segment under /ingest, dissected by Filebeat.",
  "_meta": {
    "managed_by": "dxdfir_stack",
    "source": "elastic/pipelines/logs-dxdfir-router.json"
  },
  "processors": [
    {
      "set": {
        "field": "event.ingested",
        "value": "{{{_ingest.timestamp}}}",
        "override": false
      }
    },
    {
      "remove": {
        "description": "Filebeat's own host.name (the shipper's container id), never the evidence host",
        "field": "host.name",
        "ignore_missing": true
      }
    },
    {
      "pipeline": {
        "name": "logs-dxdfir-zeek",
        "if": "ctx.labels?.type == 'zeek'"
      }
    },
    {
      "pipeline": {
        "name": "logs-dxdfir-log2timeline",
        "if": "ctx.labels?.type == 'log2timeline'"
      }
    },
    {
      "pipeline": {
        "name": "logs-dxdfir-windowlicker",
        "if": "ctx.labels?.type == 'windowlicker'"
      }
    },
    {
      "pipeline": {
        "name": "logs-dxdfir-daemonhunter",
        "if": "ctx.labels?.type == 'daemonhunter'"
      }
    },
    {
      "pipeline": {
        "name": "logs-dxdfir-anamnesis",
        "if": "ctx.labels?.type == 'anamnesis'"
      }
    },
    {
      "pipeline": {
        "name": "logs-dxdfir-detections",
        "if": "ctx.labels?.type == 'detections'"
      }
    }
  ],
  "on_failure": [
    {
      "set": {
        "field": "labels.pipeline_error",
        "value": "{{{ _ingest.on_failure_message }}}"
      }
    }
  ]
}
